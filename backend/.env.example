# 后端环境变量模板：复制为 .env 并按需修改
# .env 已被 .gitignore 忽略，不会提交到仓库

# 调试模式：true 时异常详情（含堆栈）返回给客户端，仅限本地开发，生产必须为 false
DEBUG_MODE=false

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# ---- MySQL ----
DB_USER=root
# 真实密码只写在本机 .env（已被 gitignore），此处仅占位
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_NAME=news_app

# 是否在控制台输出 SQL 日志（true/false）
SQL_ECHO=false

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis 未设密码时留空即可
REDIS_PASSWORD=

# ---- CORS ----
# 生产环境的前端来源白名单，逗号分隔，如 http://localhost:5173,https://your-domain.com
CORS_ORIGINS=
