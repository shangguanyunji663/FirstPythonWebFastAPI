# 前端环境变量模板：复制为 .env.local 并按需修改
# .env.local 已被 .gitignore 忽略，不会提交到仓库

# ---- 后端 ----
# 后端 API 基础地址（用于 src/config/api.js）；不填默认 http://127.0.0.1:8000
VITE_API_BASE_URL=

# ---- AI 提供方切换：zhipu（智谱云端）| ollama（本地）----
VITE_AI_PROVIDER=zhipu

# 智谱开放平台（open.bigmodel.cn）申请的 API Key，provider=zhipu 时生效
# 真实 Key 只放本机 .env.local，切勿提交到仓库；已泄露过的 Key 应到服务商控制台吊销
VITE_AI_API_KEY=
# 智谱模型（留空默认 glm-4.7-flash）
VITE_AI_MODEL=

# 本地 Ollama，provider=ollama 时生效（OpenAI 兼容端点，无需 Key）
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen3:4b
